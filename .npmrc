# @capacitor-firebase/authentication@8 lists firebase@^12 as a peerOptional dep,
# but the app is pinned to firebase@^11. The peer is optional and the v11 API
# surface used here is compatible, so we relax peer resolution.
# TODO(tooling milestone): align firebase major with the capacitor-firebase plugin
# (upgrade firebase to v12, or pin the plugin to a v11-compatible release) and drop this.
legacy-peer-deps=true
