rules_version = '2';

// Regras de produção.
// Princípio: o cliente só escreve o que é dele e NUNCA campos controlados pelo servidor
// (saldo, nota, verificação, unlockCount, status de proposta "accepted", transações, unlocks).
// Esses campos são gravados exclusivamente pelas Cloud Functions (Admin SDK, que ignora estas regras).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    // Contato verificado — porta de entrada para ações sensíveis (publicar pedido,
    // propor, avaliar, conversar). Cliente: só e-mail confirmado (celular é opcional
    // — obrigar os dois entraria em conflito quando a mesma pessoa já usa aquele
    // número como login da conta de profissional). Profissional: conta só de
    // telefone (o próprio login por SMS já é a verificação).
    function isVerified() {
      return isSignedIn()
        && (
          request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'phone'
        );
    }
    function incoming() {
      return request.resource.data;
    }
    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function requestData(reqId) {
      return get(/databases/$(database)/documents/serviceRequests/$(reqId)).data;
    }
    // chatId tem o formato "<requestId>_<professionalId>"
    function chatReqId(chatId) {
      return chatId.split('_')[0];
    }
    function chatProId(chatId) {
      return chatId.split('_')[1];
    }
    function isChatParticipant(chatId) {
      return isSignedIn() && (
        request.auth.uid == chatProId(chatId) ||
        requestData(chatReqId(chatId)).clientId == request.auth.uid
      );
    }

    // ---------- users (dados privados: telefone, e-mail, endereço, saldo) ----------
    match /users/{userId} {
      // Só o dono e o admin. O resto do app usa /publicProfiles.
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && incoming().id == userId
        && incoming().get('coinsBalance', 0) == 0
        && incoming().get('verified', false) == false
        && incoming().get('rating', 0) == 0
        && incoming().get('reviewCount', 0) == 0
        && incoming().get('isAdmin', false) == false
        && incoming().get('phoneConfirmed', false) == false
        && incoming().role in ['client', 'professional']
        && incoming().termsAcceptedAt is number;

      // Dono edita o próprio perfil, menos os campos controlados pelo servidor.
      allow update: if isAdmin() || (
        isOwner(userId)
        && !affected().hasAny([
          'coinsBalance', 'rating', 'ratingSum', 'reviewCount',
          'clientRating', 'clientRatingSum', 'clientReviewCount',
          'verified', 'isAdmin', 'id', 'role', 'created_at',
          'referredBy', 'referralRewarded', 'referralCount', 'contactsVerified',
          'phoneConfirmed', 'phoneConfirmedAt'
        ])
      );

      allow delete: if false;
    }

    // Leads que o profissional escondeu do próprio feed ("não tenho interesse").
    match /users/{userId}/dismissedLeads/{requestId} {
      allow read, write: if isOwner(userId);
    }

    // Central de avisos in-app (escrita só por Function; o dono lê e marca como lido).
    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // ---------- serviceRequests ----------
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn();

      allow create: if isOwner(incoming().clientId)
        && isVerified()
        && incoming().status in ['OPEN', 'NEGOTIATING']
        && incoming().get('unlockCount', 0) == 0
        && !('acceptedProfessionalId' in incoming())
        && !('acceptedProposalId' in incoming())
        && incoming().description is string
        && incoming().description.size() >= 20
        && incoming().description.size() <= 5000
        && incoming().category is string
        && incoming().category.size() <= 120;

      // Só o cliente dono, e só campos editáveis (descrição, urgência, fotos…).
      // status / aceite / contadores / carimbos são exclusivos das Functions.
      allow update: if isSignedIn()
        && resource.data.clientId == request.auth.uid
        && !affected().hasAny([
          'status', 'unlockCount', 'clientId', 'created_at',
          'acceptedProfessionalId', 'acceptedProposalId',
          'started_at', 'completed_at', 'canceled_at', 'cancelReason'
        ]);

      // A exclusão passa pela Function deleteRequest (limpa propostas/unlocks/chat).
      allow delete: if false;
    }

    // ---------- proposals ----------
    match /proposals/{proposalId} {
      allow read: if isSignedIn();

      // O profissional cria a própria proposta, sempre como "pending".
      // (a proposta de "orçamento direto" já aceita é criada por Function)
      allow create: if isVerified()
        && incoming().professionalId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().requestId is string
        && incoming().clientId is string
        && incoming().get('message', '').size() <= 3000;

      // O profissional dono ajusta a própria proposta, menos o status/aceite.
      allow update: if isSignedIn()
        && resource.data.professionalId == request.auth.uid
        && !affected().hasAny([
          'status', 'professionalId', 'clientId', 'requestId',
          'created_at', 'accepted_at'
        ]);

      allow delete: if isSignedIn()
        && resource.data.professionalId == request.auth.uid
        && resource.data.status != 'accepted';
    }

    // ---------- messages ----------
    match /messages/{messageId} {
      allow read: if isChatParticipant(resource.data.chatId);

      allow create: if isVerified()
        && incoming().senderId == request.auth.uid
        && isChatParticipant(incoming().chatId)
        && incoming().get('text', '').size() <= 5000;

      // Só o destinatário, só para marcar como lida.
      allow update: if isSignedIn()
        && affected().hasOnly(['read'])
        && incoming().read == true
        && resource.data.senderId != request.auth.uid
        && isChatParticipant(resource.data.chatId);

      allow delete: if false;
    }

    // ---------- reviews ----------
    // id determinístico: "<requestId>_<clientId>" (garante 1 avaliação por pedido/cliente)
    match /reviews/{reviewId} {
      allow read: if isSignedIn();

      allow create: if isOwner(incoming().clientId)
        && isVerified()
        && reviewId == incoming().requestId + '_' + incoming().clientId
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().get('comment', '').size() <= 3000
        && requestData(incoming().requestId).clientId == request.auth.uid
        && requestData(incoming().requestId).status == 'COMPLETED'
        && requestData(incoming().requestId).acceptedProfessionalId == incoming().professionalId;

      allow update, delete: if false;
    }

    // ---------- clientReviews (o profissional avalia o cliente) ----------
    // id determinístico: "<requestId>_<professionalId>"
    match /clientReviews/{reviewId} {
      allow read: if isSignedIn();

      allow create: if isOwner(incoming().professionalId)
        && isVerified()
        && reviewId == incoming().requestId + '_' + incoming().professionalId
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().get('comment', '').size() <= 3000
        && requestData(incoming().requestId).acceptedProfessionalId == request.auth.uid
        && requestData(incoming().requestId).status == 'COMPLETED'
        && requestData(incoming().requestId).clientId == incoming().clientId;

      allow update, delete: if false;
    }

    // ---------- unlocks (só Function) ----------
    match /unlocks/{unlockId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- transactions (só Function) ----------
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------- payments (Mercado Pago) — criado/atualizado só por Function/webhook ----------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------- supportTickets (suporte / disputas) ----------
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && incoming().category in ['fake_lead', 'no_show', 'abusive', 'payment', 'app_error', 'other']
        && incoming().message is string
        && incoming().message.size() >= 10
        && incoming().message.size() <= 5000
        && incoming().subject is string
        && incoming().subject.size() <= 200;

      // Resolução/resposta é só via Function resolveSupportTicket.
      allow update, delete: if false;
    }

    // ---------- validations (KYC) ----------
    // Escrita só via Function submitCpfValidation (impede CPF duplicado entre contas
    // — precisa de uma checagem atômica contra cpfIndex/* que as regras não fazem).
    match /validations/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Índice CPF -> uid (só a Function lê/escreve, via Admin SDK).
    match /cpfIndex/{cpf} {
      allow read, write: if false;
    }

    // ---------- publicProfiles (projeção segura, mantida pela Function syncPublicProfile) ----------
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
